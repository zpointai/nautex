model InventoryItem {
  learningCorrections ItemLearningCorrection[]
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  itemCode       String?   @map("item_code")
  catalogItemId  String?   @map("catalog_item_id")
  description    String
  category       String?
  warehouse      String
  locationBin    String?   @map("location_bin")
  uom            String
  onHand         Int       @map("on_hand")
  reserved       Int       @default(0)
  inbound        Int       @default(0)
  reorderPoint   Int       @map("reorder_point")
  dangerousGoods Boolean   @default(false) @map("dangerous_goods")
  notes          String?
  lastCountedAt  DateTime? @map("last_counted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements            InventoryMovement[]
  unitConversions      InventoryUnitConversion[]
  reservations         InventoryReservation[]
  sourceTransfers      InventoryTransfer[]    @relation("InventoryTransferSource")
  destinationTransfers InventoryTransfer[]    @relation("InventoryTransferDestination")
  cycleCounts          InventoryCycleCount[]
