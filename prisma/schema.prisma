model AgentSchedule {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  agentId         String       @map("agent_id")
  action          String
  params          Json
  intervalMinutes Int          @map("interval_minutes")
  maxDailyRuns    Int          @default(24) @map("max_daily_runs")
  allowProvider   Boolean      @default(false) @map("allow_provider")
  enabled         Boolean      @default(true)
  revision        Int          @default(1)
  requestKey      String       @map("request_key")
  createdBy       String       @map("created_by")
  nextRunAt       DateTime     @map("next_run_at")
  occurrenceAt    DateTime?    @map("occurrence_at")
  leaseUntil      DateTime?    @map("lease_until")
  attempts        Int          @default(0)
  activeKey       String?      @map("active_key")
  lastRunId       String?      @map("last_run_id")
  lastError       String?      @map("last_error")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestKey])
  @@index([enabled, nextRunAt])
  @@map("agent_schedules")
}

model ItemLearningCorrection {
