// ═══════════════════════════════════════════════════════════════
// AUTOMATION / AGENT ENTITIES
// ═══════════════════════════════════════════════════════════════

// ── Agent Runs ──────────────────────────────────────────────────
// One record per agent invocation (a "run" may contain multiple tasks)

model AgentRun {
  id             String         @id @default(cuid())
  organizationId String?        @map("organization_id")
  agent          String // e.g. "command_router", "rfq_intake", "classification"
  domain         String // e.g. "procurement", "classification"
  trigger        String // "command", "module", "scheduled", "webhook"
  commandText    String?        @map("command_text") // original user command if any
  status         AgentRunStatus @default(Running)
  requestKey     String?        @map("request_key")
  requestedBy    String?        @map("requested_by")
  retryOfId      String?        @map("retry_of_id")
  parentRunId    String?        @map("parent_run_id")
  leaseExpiresAt DateTime?      @map("lease_expires_at")
  cancelRequestedAt DateTime?   @map("cancel_requested_at")

  tasks        AgentTask[]
  auditLogs    AuditLog[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  @@index([agent])
  @@unique([organizationId, requestKey])
  @@index([status])
  @@index([organizationId, status])
  @@map("agent_runs")
}

enum AgentRunStatus {
  Running
  Cancelled
  Completed
  Failed
  AwaitingApproval @map("Awaiting Approval")
}

// ── Agent Tasks ─────────────────────────────────────────────────
// Individual steps within an agent run

model AgentTask {
  id         String          @id @default(cuid())
  runId      String          @map("run_id")
  agent      String
  action     String // e.g. "classify_hs", "find_suppliers", "parse_rfq"
  input      Json            @default("{}")
  output     Json?
  status     AgentTaskStatus @default(Pending)
  confidence Float? // 0.0–1.0
  model      String? // AI model used
  provider   String? // AI provider used
  error      String?

  run        AgentRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvals  Approval[]
  exceptions AgentException[]

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  @@index([runId])
  @@index([status])
  @@map("agent_tasks")
}

enum AgentTaskStatus {
  Pending
  Running
  Cancelled
  Completed
  Failed
  AwaitingApproval @map("Awaiting Approval")
  AutoCommitted    @map("Auto Committed")
}

model AgentControl {
  organizationId String @map("organization_id")
  agentId String @map("agent_id")
  enabled Boolean
  revision Int @default(0)
  updatedBy String @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@id([organizationId, agentId])
  @@map("agent_controls")
}

// ── Approvals ───────────────────────────────────────────────────

model Approval {
  id          String         @id @default(cuid())
  taskId      String         @map("task_id")
  agent       String
  domain      String
  description String
  impact      String         @default("medium") // "low" | "medium" | "high"
  status      ApprovalStatus @default(Pending)
  data        Json? // the proposed change for review
  resolvedBy  String?        @map("resolved_by")

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  requestedAt DateTime  @default(now()) @map("requested_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([status])
  @@map("approvals")
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
  AutoApproved @map("Auto Approved")
}

// ── Exceptions ──────────────────────────────────────────────────

model AgentException {
  id              String            @id @default(cuid())
  organizationId  String?           @map("organization_id")
  taskId          String?           @map("task_id")
  agent           String
  domain          String
  severity        ExceptionSeverity @default(Warning)
  title           String
  description     String
  suggestedAction String?           @map("suggested_action")
  status          ExceptionStatus   @default(Open)
  resolvedBy      String?           @map("resolved_by")

  task         AgentTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([status])
  @@index([severity])
  @@index([organizationId, status])
  @@map("agent_exceptions")
}

enum ExceptionSeverity {
  Critical
  Warning
  Info
}

enum ExceptionStatus {
  Open
  Reviewing
  Resolved
  Dismissed
}

