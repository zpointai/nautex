  delivery             Delivery              @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  purchaseOrderLine    PurchaseOrderLine     @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  inventoryItem        InventoryItem?        @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryReservation InventoryReservation? @relation(fields: [inventoryReservationId], references: [id], onDelete: SetNull)
  inventoryMovement    InventoryMovement?    @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)

