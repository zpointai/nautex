  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
  @@index([inventoryItemId])
  @@map("goods_receipt_lines")
}

enum GoodsReceiptStatus {
  Draft
  Posted
  Cancelled
}

model Delivery {
  id                String         @id @default(cuid())
  organizationId    String         @map("organization_id")
  legalEntityId     String?        @map("legal_entity_id")
  purchaseOrderId   String         @map("purchase_order_id")
  shippingCompanyId String?        @map("shipping_company_id")
  partyId           String?        @map("party_id")
  deliveryNumber    String?        @map("delivery_number")
  sourceKey         String         @unique @map("source_key")
  customerName      String         @map("customer_name")
