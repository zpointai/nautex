enum OrderType {
  BuyerPO // Inbound PO from buyer (shipping company) to chandler
  SubPO // Outbound PO from chandler to sub-supplier
  DirectPO // Manual standalone PO (legacy/default)
}

enum ShipServLifecycle {
  RFQ_Received    @map("RFQ Received")
  Quote_Sent      @map("Quote Sent")
  PO_Received     @map("PO Received")
  Order_Confirmed @map("Order Confirmed")
  Invoiced
  Closed
}

// ── Order Line Allocations (buyer PO line → sub-PO line split) ──

model OrderLineAllocation {
  id                String @id @default(cuid())
  buyerLineId       String @map("buyer_line_id")
  subPoLineId       String @map("sub_po_line_id")
  allocatedQty      Float  @map("allocated_qty")
  buyerUnitPrice    Float  @map("buyer_unit_price")
  supplierUnitPrice Float  @map("supplier_unit_price")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([buyerLineId, subPoLineId])
  @@index([buyerLineId])
  @@index([subPoLineId])
  @@map("order_line_allocations")
}

enum OrderStatus {
  Pending_Approval @map("Pending Approval")
  Procurement
  In_Transit       @map("In Transit")
  Delivered
  At_Risk          @map("At Risk")
}

enum ConfirmStatus {
  Unconfirmed
  Partially_Confirmed @map("Partially Confirmed")
  Confirmed
  Rejected
}

enum LineStatus {
  Open
  Confirmed
  Partially_Delivered @map("Partially Delivered")
  Delivered
  Backordered
  Cancelled
}

enum SlaEvidenceStatus {
  Processing
  Completed
  NeedsReview
  Reviewed
  Archived
  Failed
}

enum Priority {
  High
  Normal
  Low
}

