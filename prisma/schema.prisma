// ═══════════════════════════════════════════════════════════════
// SUPPLIER MATCHING PIPELINE
// ═══════════════════════════════════════════════════════════════

// ── Match Runs — one per supplier search / discovery request ────

model MatchRun {
  id                  String         @id @default(cuid())
  query               Json // { name?, country?, region?, category?, keywords?, context? }
  source              String // "manual_search" | "create_form" | "po_context" | "enrich"
  status              MatchRunStatus @default(Running)
  candidateCount      Int            @default(0) @map("candidate_count")
  acceptedCandidateId String?        @map("accepted_candidate_id")
  savedSupplierId     String?        @map("saved_supplier_id") // The supplier record created from accepted candidate

  candidates MatchCandidate[]

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([status])
  @@index([createdAt])
  @@map("match_runs")
}

enum MatchRunStatus {
  Running
  Ranked // Candidates ranked, awaiting user decision
  Accepted // User accepted a candidate
  AllRejected // User rejected all candidates
  Expired // Auto-expired (no user action)
  Failed // Pipeline error
}

// ── Match Candidates — individual supplier candidates per run ───

model MatchCandidate {
  id        String @id @default(cuid())
  runId     String @map("run_id")
  rank      Int // 1 = best match
  sourceTag String @map("source_tag") // "internal_db" | "ai_generated" | "ai_enrichment"

  // Candidate profile
  name          String
  region        String?
  country       String?
  city          String?
  address       String?
  phone         String?
  email         String?
  website       String?
  contactPerson String?  @map("contact_person")
  description   String?
  categories    String[] @default([])
  portsCovered  String[] @default([]) @map("ports_covered")
  lat           Float?
  lng           Float?

  // Scoring
  overallScore   Float  @map("overall_score") // 0.0 – 1.0
  confidenceBand String @map("confidence_band") // "high" | "medium" | "low"
  scoreBreakdown Json   @map("score_breakdown") // { nameMatch, locationMatch, categoryFit, ... }
  explanation    String // Human-readable ranking rationale

  // Validation
  conflicts     Json? // { field: { issue, severity } }
  missingFields String[] @default([]) @map("missing_fields")

  // Link to existing supplier if matched
  existingSupplierId String? @map("existing_supplier_id")

  // Outcome
  outcome   CandidateOutcome @default(Pending)
  userEdits Json?            @map("user_edits") // { field: { from, to } }

  run MatchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([runId, rank])
  @@map("match_candidates")
}

enum CandidateOutcome {
  Pending
  Accepted
  AcceptedWithEdits @map("Accepted With Edits")
  Rejected
}

// ── Match Feedback — learning signals from user decisions ────────

model MatchFeedback {
  id                String  @id @default(cuid())
  runId             String  @map("run_id")
  candidateId       String  @map("candidate_id")
  action            String // "accept" | "reject" | "edit_accept"
  correctedFields   Json?   @map("corrected_fields") // { field: { from, to } }
  rejectionReason   String? @map("rejection_reason")
  querySnapshot     Json    @map("query_snapshot")
  candidateSnapshot Json    @map("candidate_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([createdAt])
  @@map("match_feedback")
}

// ── Source Reliability — learned source quality over time ────────

model SourceReliability {
  id         String @id @default(cuid())
  sourceType String @map("source_type") // "internal_db" | "ai_generated" | "ai_enrichment"
  sourceKey  String @map("source_key") // More specific: model name, search method, etc.

  totalUses   Int   @default(0) @map("total_uses")
  accepts     Int   @default(0)
  rejects     Int   @default(0)
  edits       Int   @default(0)
  reliability Float @default(0.5) // 0.0 – 1.0 computed

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sourceType, sourceKey])
  @@map("source_reliability")
}

