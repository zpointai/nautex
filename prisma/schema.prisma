generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Improvement records are organization scoped and never consumed as live rules.
model ImprovementObservation {
  id               String @id @default(cuid())
  organizationId   String @map("organization_id")
  legalEntityId    String? @map("legal_entity_id")
  moduleKey        String @map("module_key")
  kind             String
  sourceId         String? @map("source_id")
  sourceHash       String @map("source_hash")
  summary          String
  snapshot         Json
  actorId          String @map("actor_id")
  dedupeKey        String @map("dedupe_key")
  createdAt        DateTime @default(now()) @map("created_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  proposalEvidence ImprovementProposalEvidence[]
  outcomes         ImprovementOutcome[]

  @@unique([organizationId, id])
  @@unique([organizationId, dedupeKey])
  @@index([organizationId, moduleKey, createdAt])
  @@map("improvement_observations")
}

model ImprovementProposal {
  id              String @id @default(cuid())
  organizationId  String @map("organization_id")
  legalEntityId   String? @map("legal_entity_id")
  moduleKey       String @map("module_key")
  title           String
  hypothesis      String
  candidate       String
  evaluationPlan  String @map("evaluation_plan")
  successCriteria String @map("success_criteria")
  stopCondition   String @map("stop_condition")
  experimentKey   String? @map("experiment_key")
  candidateConfig Json? @map("candidate_config")
  status          ImprovementProposalStatus @default(Proposed)
  revision        Int @default(1)
  requestKey      String @map("request_key")
  contentHash     String @map("content_hash")
  actorId         String @map("actor_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evidence        ImprovementProposalEvidence[]
  decisions       ImprovementDecision[]
  outcomeLinks    ImprovementProposalOutcome[]
  evaluations     ImprovementEvaluation[]

  @@unique([organizationId, id])
  @@unique([organizationId, requestKey])
  @@index([organizationId, moduleKey, createdAt])
  @@map("improvement_proposals")
}

enum ImprovementProposalStatus {
  Proposed
  ExperimentApproved
  Rejected
  Revoked
}

model ImprovementProposalEvidence {
  organizationId String @map("organization_id")
  proposalId     String @map("proposal_id")
  observationId  String @map("observation_id")
  proposal       ImprovementProposal @relation(fields: [organizationId, proposalId], references: [organizationId, id], onDelete: Restrict)
  observation    ImprovementObservation @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Restrict)

  @@id([proposalId, observationId])
  @@index([organizationId, observationId])
  @@map("improvement_proposal_evidence")
}

model ImprovementDecision {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  proposalId     String @map("proposal_id")
  revision       Int
  action         String
  reason         String
  actorId        String @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")
  proposal       ImprovementProposal @relation(fields: [organizationId, proposalId], references: [organizationId, id], onDelete: Restrict)

  @@unique([proposalId, revision])
  @@map("improvement_decisions")
}

model ImprovementOutcome {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  observationId  String @map("observation_id")
  finding        String
  expected       String
  actual         String
  basis          String
  status         String @default("Pending")
  revision       Int @default(1)
  actorId        String @map("actor_id")
  contentHash    String @map("content_hash")
  requestKey     String @map("request_key")
  createdAt      DateTime @default(now()) @map("created_at")
  observation    ImprovementObservation @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Restrict)
  reviews        ImprovementOutcomeReview[]
  proposals      ImprovementProposalOutcome[]
  @@unique([organizationId, id])
  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@map("improvement_outcomes")
}

model ImprovementOutcomeReview {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  outcomeId      String @map("outcome_id")
  revision       Int
  action         String
  reason         String
  actorId        String @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")
  outcome        ImprovementOutcome @relation(fields: [organizationId, outcomeId], references: [organizationId, id], onDelete: Restrict)
  @@unique([outcomeId, revision])
  @@map("improvement_outcome_reviews")
}

model ImprovementProposalOutcome {
  organizationId String @map("organization_id")
  proposalId     String @map("proposal_id")
  outcomeId      String @map("outcome_id")
  outcomeRevision Int @map("outcome_revision")
  proposal       ImprovementProposal @relation(fields: [organizationId, proposalId], references: [organizationId, id], onDelete: Restrict)
  outcome        ImprovementOutcome @relation(fields: [organizationId, outcomeId], references: [organizationId, id], onDelete: Restrict)
  @@id([proposalId, outcomeId])
  @@map("improvement_proposal_outcomes")
}

model ImprovementEvaluation {
  id               String @id @default(cuid())
  organizationId   String @map("organization_id")
  proposalId       String @map("proposal_id")
  proposalRevision Int @map("proposal_revision")
  requestKey       String @map("request_key")
  inputHash        String @map("input_hash")
  actorId          String @map("actor_id")
  experimentKey    String @map("experiment_key")
  evaluatorVersion String @map("evaluator_version")
  suiteHash        String @map("suite_hash")
  configurationHash String @map("configuration_hash")
  softwareVersion  String @map("software_version")
  policyVersion    String @map("policy_version")
  result           Json
  createdAt        DateTime @default(now()) @map("created_at")
  proposal         ImprovementProposal @relation(fields: [organizationId, proposalId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@map("improvement_evaluations")
}

// -- Authentication and RBAC foundation ---------------------------

model User {
  id              String                   @id
  name            String
  email           String                   @unique
  emailVerified   Boolean                  @default(false) @map("email_verified")
  image           String?
  status          UserStatus               @default(Active)
  lastLoginAt     DateTime?                @map("last_login_at")
  metadata        Json                     @default("{}")
  sessions        Session[]
  accounts        Account[]
  roleAssignments UserRoleAssignment[]
  memberships     OrganizationMembership[]
  assignedRfqs    Rfq[]                    @relation("RfqAssignee")
  assignedPurchaseOrders PurchaseOrder[]   @relation("PurchaseOrderAssignee")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model Role {
  id                      String                       @id @default(cuid())
  code                    String                       @unique
  name                    String
  description             String?
  isSystem                Boolean                      @default(true) @map("is_system")
  permissions             RolePermission[]
  assignments             UserRoleAssignment[]
  organizationAssignments OrganizationMembershipRole[]
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

enum UserStatus {
  Active
  Suspended
  Disabled
}

// -- Customer organization and data-access boundary ---------------

model Organization {
  jevSettings JevSettings?
  jevReviews JevReview[]
  agentSchedules AgentSchedule[]
  itemLearningCorrections ItemLearningCorrection[]
  mailboxConnections MailboxConnection[]
  mailboxReplies MailboxReply[]
  learningCorrections LearningCorrection[]
  id       String               @id @default(cuid())
  code     String               @unique
  name     String
  status   OrganizationStatus   @default(Active)
  dataMode OrganizationDataMode @default(Operational) @map("data_mode")
  metadata Json                 @default("{}")

  memberships        OrganizationMembership[]
  legalEntities      LegalEntity[]
  rfqs               Rfq[]
  suppliers          Supplier[]
  shippingCompanies  ShippingCompany[]
  agreementVersions  AgreementVersion[]
  purchaseOrders     PurchaseOrder[]
  inventoryItems     InventoryItem[]
  customerAccounts   CustomerAccount[]
  supplierInvoices   SupplierInvoice[]
  financeExceptions  FinanceException[]
  financeAuditEvents FinanceAuditEvent[]
  accountingExports  AccountingExportBatch[]
  auditEvents        AuditEvent[]
  documents          ErpDocument[]
  provenance         DataProvenance[]
  agentRuns          AgentRun[]
  agentControls      AgentControl[]
  improvementObservations ImprovementObservation[]
  improvementProposals    ImprovementProposal[]
  agentExceptions    AgentException[]
  validationRuns     ValidationRun[]
  apiIdempotency     ApiIdempotencyRecord[]
  backorders         Backorder[]
  goodsReceipts      GoodsReceipt[]
  deliveries         Delivery[]
  supplierInquiries  SupplierInquiry[]
  customerQuotes     CustomerQuote[]
  salesOrders        SalesOrder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([dataMode, status])
  @@map("organizations")
}

model JevSettings {
  organizationId String @id @map("organization_id")
  secretCiphertext Json? @map("secret_ciphertext")
  enabled Boolean @default(false)
  dailyLimit Int @default(20) @map("daily_limit")
  revision Int @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@map("jev_settings")
}

model JevReview {
  id String @id @default(cuid())
  organizationId String @map("organization_id")
  requestKey String @map("request_key")
  requestHash String @map("request_hash")
  sourceHash String @map("source_hash")
  requestedBy String @map("requested_by")
  kind String
  recordId String @map("record_id")
  status String
  providerAttempted Boolean @default(false) @map("provider_attempted")
  result Json?
  inputTokens Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")
  durationMs Int? @map("duration_ms")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@map("jev_reviews")
}

model OrganizationMembership {
  id             String                   @id @default(cuid())
  organizationId String                   @map("organization_id")
  userId         String                   @map("user_id")
  status         OrganizationMemberStatus @default(Active)
  isDefault      Boolean                  @default(false) @map("is_default")

  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles             OrganizationMembershipRole[]
  legalEntityAccess LegalEntityAccess[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_memberships")
}

model OrganizationMembershipRole {
  membershipId String @map("membership_id")
  roleId       String @map("role_id")

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt  DateTime               @default(now()) @map("created_at")

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("organization_membership_roles")
}

model LegalEntityAccess {
  membershipId  String @map("membership_id")
  legalEntityId String @map("legal_entity_id")

  membership  OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity            @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now()) @map("created_at")

  @@id([membershipId, legalEntityId])
  @@index([legalEntityId])
  @@map("legal_entity_access")
}

enum OrganizationStatus {
  Active
  Suspended
  Archived
}

enum OrganizationDataMode {
  Operational
  Demo
  Screenshot
  Test
}

enum OrganizationMemberStatus {
  Invited
  Active
  Suspended
  Removed
}

model ApiIdempotencyRecord {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  route          String
  key            String
  requestHash    String               @map("request_hash")
  status         ApiIdempotencyStatus @default(Processing)
  responseStatus Int?                 @map("response_status")
  responseBody   Json?                @map("response_body")
  expiresAt      DateTime             @map("expires_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, route, key])
  @@index([expiresAt])
  @@map("api_idempotency_records")
}

enum ApiIdempotencyStatus {
  Processing
  Completed
}

// ═══════════════════════════════════════════════════════════════
// BUSINESS ENTITIES
// ═══════════════════════════════════════════════════════════════

// ── RFQ Management ──────────────────────────────────────────────

model Rfq {
  review Json?
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  vessel         String
  port           String
  neededBy       String    @map("needed_by")
  status         RfqStatus @default(Draft)
  source         String? // "manual" | "email" | "upload" | "command"
  assignedToId   String?   @map("assigned_to_id")

  lines             RfqLine[]
  purchaseOrders    PurchaseOrder[]
  supplierInquiries SupplierInquiry[]
  customerQuotes    CustomerQuote[]
  salesOrders       SalesOrder[]
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo        User?             @relation("RfqAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([organizationId, assignedToId, status])
  @@map("rfqs")
}

model RfqLine {
  id             String  @id @default(cuid())
  rfqId          String  @map("rfq_id")
  lineNumber     Int     @map("line_number")
  description    String
  quantity       Float
  unit           String
  impaCode       String? @map("impa_code")
  hsCode         String? @map("hs_code")
  countryOrigin  String? @map("country_origin")
  normalizedDesc String? @map("normalized_desc")

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierQuotes       SupplierQuote[]
  supplierInquiryLines SupplierInquiryLine[]
  customerQuoteLines   CustomerQuoteLine[]
  salesOrderLines      SalesOrderLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rfq_lines")
}

enum RfqStatus {
  Draft
  Sent
  Quoted
  Awarded
}

// ── Items / Product Catalog ─────────────────────────────────────

model Item {
  id             String  @id @default(cuid())
  description    String
  normalizedDesc String? @map("normalized_desc")
  impaCode       String? @map("impa_code")
  hsCodeEu       String? @map("hs_code_eu")
  hsCodeUs       String? @map("hs_code_us")
  countryOrigin  String? @map("country_origin")
  category       String?
  unit           String?
  source         String?
  edition        String?
  raw            Json    @default("{}")
  isDeleted      Boolean @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([impaCode])
  @@index([category])
  @@map("items")
}

model DatasetImport {
  id             String  @id @default(cuid())
  type           String
  sourceFileName String? @map("source_file_name")
  sourcePath     String? @map("source_path")
  status         String  @default("Completed")
  rowCount       Int     @default(0) @map("row_count")
  importedCount  Int     @default(0) @map("imported_count")
  skippedCount   Int     @default(0) @map("skipped_count")
  errorCount     Int     @default(0) @map("error_count")
  errors         Json    @default("[]")
  metadata       Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@map("dataset_imports")
}

model ImpaFavorite {
  id       String  @id @default(cuid())
  organizationId String? @map("organization_id")
  impaCode String  @map("impa_code")
  itemId   String? @map("item_id")
  label    String?
  userId   String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@unique([organizationId, impaCode])
  @@map("impa_favorites")
}

// ── Suppliers ───────────────────────────────────────────────────

// -- ERP Core: Party / identity foundation -------------------------

model Party {
  id             String      @id @default(cuid())
  displayName    String      @map("display_name")
  legalName      String?     @map("legal_name")
  normalizedName String      @map("normalized_name")
  kind           PartyKind   @default(Organization)
  status         PartyStatus @default(Active)
  country        String?
  city           String?
  address        String?
  phone          String?
  email          String?
  website        String?
  vatId          String?     @map("vat_id")
  companyNumber  String?     @map("company_number")
  metadata       Json        @default("{}")

  roles              PartyRoleAssignment[]
  aliases            PartyAlias[]
  externalReferences ExternalReference[]
  suppliers          Supplier[]
  shippingCompanies  ShippingCompany[]
  customerAccounts   CustomerAccount[]
  goodsReceipts      GoodsReceipt[]
  deliveries         Delivery[]
  supplierInquiries  SupplierInquiry[]
  customerQuotes     CustomerQuote[]
  salesOrders        SalesOrder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([normalizedName])
  @@index([kind, status])
  @@map("parties")
}

model PartyRoleAssignment {
  id          String        @id @default(cuid())
  partyId     String        @map("party_id")
  role        PartyRoleType
  sourceModel String?       @map("source_model")
  sourceId    String?       @map("source_id")
  isPrimary   Boolean       @default(false) @map("is_primary")
  validFrom   DateTime?     @map("valid_from")
  validTo     DateTime?     @map("valid_to")
  metadata    Json          @default("{}")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, role])
  @@index([sourceModel, sourceId])
  @@map("party_role_assignments")
}

model PartyAlias {
  id              String  @id @default(cuid())
  partyId         String  @map("party_id")
  alias           String
  normalizedAlias String  @map("normalized_alias")
  aliasType       String  @default("name") @map("alias_type")
  sourceModule    String? @map("source_module")
  confidence      Float?
  metadata        Json    @default("{}")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("party_aliases")
}

model ExternalReference {
  id             String  @id @default(cuid())
  partyId        String? @map("party_id")
  entityType     String  @map("entity_type")
  entityId       String  @map("entity_id")
  system         String
  referenceType  String  @map("reference_type")
  referenceValue String  @map("reference_value")
  metadata       Json    @default("{}")

  party Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@unique([system, referenceType, referenceValue])
  @@index([entityType, entityId])
  @@index([partyId])
  @@map("external_references")
}

enum PartyKind {
  Organization
  Person
  Unknown
}

enum PartyStatus {
  Active
  Inactive
  Watch
  Blocked
  Archived
}

enum PartyRoleType {
  Customer
  Supplier
  Vendor
  ShippingCompany
  Owner
  Agent
  Broker
  LegalEntity
  Contact
  Other
}

model Supplier {
  learningCorrections LearningCorrection[]
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")
  partyId        String? @map("party_id")
  supplierCode   String  @unique @map("supplier_code") // e.g. SUP-0042
  name           String
  region         String
  country        String?
  city           String?
  address        String?
  phone          String?
  email          String?
  website        String?
  contactPerson  String? @map("contact_person")
  description    String?

  // Classification
  categories   String[] @default([])
  portsCovered String[] @default([]) @map("ports_covered")

  // Performance
  score        Int @default(0)
  leadTimeDays Int @default(0) @map("lead_time_days")

  // Coordinates (for map view)
  lat Float?
  lng Float?

  // Status & enrichment
  status           SupplierStatus  @default(Active)
  enrichmentStatus EnrichmentState @default(None) @map("enrichment_status")
  confidence       Float? // 0.0–1.0, AI enrichment confidence
  sourceReferences String[]        @default([]) @map("source_references") // URLs or source IDs

  contracts         Contract[]
  agreementVersions AgreementVersion[]
  supplierQuotes    SupplierQuote[]
  supplierInquiries SupplierInquiry[]
  purchaseOrders    PurchaseOrder[]
  supplierInvoices  SupplierInvoice[]
  backorders        Backorder[]
  goodsReceipts     GoodsReceipt[]
  party             Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([region])
  @@index([supplierCode])
  @@index([partyId])
  @@index([organizationId, status])
  @@map("suppliers")
}

enum SupplierStatus {
  Suggested
  Active
  Inactive
  Verified
  Watch
  Blocked
  Rejected
  Needs_Review @map("Needs Review")
}

enum EnrichmentState {
  None
  Pending
  Enriching
  Enriched
  Failed
}

model ShippingCompany {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")
  partyId        String? @map("party_id")
  name           String
  legalName      String? @map("legal_name")
  address        String?
  postalCode     String? @map("postal_code")
  city           String?
  country        String?
  contactName    String? @map("contact_name")
  email          String?
  phone          String?
  vatId          String? @map("vat_id")
  companyNumber  String? @map("company_number")
  paymentTerms   String? @map("payment_terms")
  invoiceEmail   String? @map("invoice_email")
  notes          String?
  source         String  @default("manual")
  website        String?
  sourceReview   Json?   @map("source_review")

  customerContracts CustomerContract[]
  fleetVessels      ShippingCompanyVessel[]
  deliveries        Delivery[]
  party             Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([partyId])
  @@index([organizationId])
  @@map("shipping_companies")
  @@unique([organizationId, name])
}

// Customer fleet registration is independent of AIS observations and purchase orders.
model ShippingCompanyVessel {
  id                String @id @default(cuid())
  shippingCompanyId String @map("shipping_company_id")
  name              String
  nameKey           String @map("name_key")
  imo               String?
  mmsi              String?
  notes             String?
  shippingCompany   ShippingCompany @relation(fields: [shippingCompanyId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([shippingCompanyId, nameKey])
  @@unique([shippingCompanyId, imo])
  @@unique([shippingCompanyId, mmsi])
  @@map("shipping_company_vessels")
}

// ── Supplier Quotes ─────────────────────────────────────────────

model SupplierQuote {
  id                    String      @id @default(cuid())
  supplierId            String      @map("supplier_id")
  rfqLineId             String?     @map("rfq_line_id")
  description           String
  unitPrice             Float       @map("unit_price")
  currency              String      @default("EUR")
  leadTimeDays          Int?        @map("lead_time_days")
  stockStatus           String?     @map("stock_status")
  status                QuoteStatus @default(Received)
  supplierInquiryLineId String?     @unique @map("supplier_inquiry_line_id")

  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  rfqLine             RfqLine?             @relation(fields: [rfqLineId], references: [id])
  supplierInquiryLine SupplierInquiryLine? @relation(fields: [supplierInquiryLineId], references: [id], onDelete: SetNull)
  customerQuoteLines  CustomerQuoteLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("supplier_quotes")
}

model SupplierInquiry {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  legalEntityId  String?               @map("legal_entity_id")
  rfqId          String                @map("rfq_id")
  supplierId     String                @map("supplier_id")
  partyId        String?               @map("party_id")
  inquiryNumber  String?               @map("inquiry_number")
  sourceKey      String                @unique @map("source_key")
  status         SupplierInquiryStatus @default(Draft)
  subject        String
  message        String?
  responseDueAt  DateTime?             @map("response_due_at")
  sentAt         DateTime?             @map("sent_at")
  respondedAt    DateTime?             @map("responded_at")
  closedAt       DateTime?             @map("closed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  createdById    String?               @map("created_by_id")
  createdByName  String?               @map("created_by_name")
  version        Int                   @default(1)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity  LegalEntity?          @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  rfq          Rfq                   @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  party        Party?                @relation(fields: [partyId], references: [id], onDelete: SetNull)
  lines        SupplierInquiryLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, inquiryNumber])
  @@index([organizationId, status, responseDueAt])
  @@index([rfqId, status])
  @@index([supplierId, status])
  @@index([partyId])
  @@map("supplier_inquiries")
}

model SupplierInquiryLine {
  id           String                    @id @default(cuid())
  inquiryId    String                    @map("inquiry_id")
  rfqLineId    String                    @map("rfq_line_id")
  lineNumber   Int                       @map("line_number")
  description  String
  quantity     Float
  unit         String
  impaCode     String?                   @map("impa_code")
  status       SupplierInquiryLineStatus @default(Pending)
  responseNote String?                   @map("response_note")
  respondedAt  DateTime?                 @map("responded_at")

  inquiry       SupplierInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  rfqLine       RfqLine         @relation(fields: [rfqLineId], references: [id], onDelete: Restrict)
  supplierQuote SupplierQuote?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([inquiryId, rfqLineId])
  @@unique([inquiryId, lineNumber])
  @@index([rfqLineId])
  @@index([inquiryId, status])
  @@map("supplier_inquiry_lines")
}

enum SupplierInquiryStatus {
  Draft
  Sent
  PartiallyResponded
  Responded
  Closed
  Cancelled
}

enum SupplierInquiryLineStatus {
  Pending
  Quoted
  Unavailable
  NoResponse
}

enum QuoteStatus {
  Draft
  Sent
  Received
  Accepted
  Rejected
}

// ── Contracts (legacy — kept for backward compat) ──────────────

model Contract {
  id          String         @id @default(cuid())
  supplierId  String         @map("supplier_id")
  title       String
  startDate   String         @map("start_date")
  endDate     String         @map("end_date")
  discountPct Float          @map("discount_pct")
  status      ContractStatus @default(Active)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contracts")
}

enum ContractStatus {
  Active
  Expiring
  Expired
}

// ═══════════════════════════════════════════════════════════════
// AGREEMENTS MODULE
// ═══════════════════════════════════════════════════════════════

// ── Agreement Versions ─────────────────────────────────────────
// Versioned supplier agreements with pricing, markup, and lifecycle.
// Each version represents a snapshot of the agreement at a point in time.

model AgreementVersion {
  id             String          @id @default(cuid())
  organizationId String?         @map("organization_id")
  supplierId     String          @map("supplier_id")
  supplierName   String          @map("supplier_name") // denormalized for fast display
  versionNumber  Int             @default(1) @map("version_number")
  status         AgreementStatus @default(Draft)

  // Pricing
  markupPercent      Float  @default(0) @map("markup_percent")
  totalBaseValue     Float  @default(0) @map("total_base_value")
  totalMarkedUpValue Float  @default(0) @map("total_marked_up_value")
  currency           String @default("EUR")

  // Validity
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")

  // Tracking
  sentAt           DateTime? @map("sent_at")
  exportedFileName String?   @map("exported_file_name")
  notes            String?

  // Relations
  supplier                Supplier                          @relation(fields: [supplierId], references: [id])
  organization            Organization?                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items                   AgreementItem[]
  comparisons             AgreementComparison[]
  customerContractSources CustomerContractSourceAgreement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([status])
  @@index([validTo])
  @@index([organizationId, status])
  @@map("agreement_versions")
}

enum AgreementStatus {
  Draft
  Sent
  AgreementActive  @map("Active")
  AgreementExpired @map("Expired")
  Archived
}

// ── Agreement Items ────────────────────────────────────────────
// Line items attached to an agreement version.

model AgreementItem {
  id         String @id @default(cuid())
  versionId  String @map("version_id")
  lineNumber Int    @map("line_number")

  // Item identification
  offiNumber       String? @map("offi_number")
  systemId         String? @map("system_id")
  vendorPartNumber String? @map("vendor_part_number")
  description      String

  // Pricing
  basePrice     Float  @map("base_price")
  markedUpPrice Float? @map("marked_up_price")
  currency      String @default("EUR")

  // Details
  unit            String?
  moq             Int?
  leadTimeDays    Int?    @map("lead_time_days")
  hsCode          String? @map("hs_code") // 8-digit TARIC format, e.g. "73269098"
  countryOfOrigin String? @map("country_of_origin") // ISO 3166-1 alpha-3, e.g. "DEU"
  cooConfidence   String? @map("coo_confidence") // "High" | "Medium" | "Low"
  manufacturer    String?

  version               AgreementVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  customerContractItems CustomerContractItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([versionId])
  @@map("agreement_items")
}

// Customer contracts combine supplier trade agreements into shipping-company price commitments.
// These are the agreements Nautex, as ship chandler, has with shipping-company customers.

model CustomerContract {
  id                  String                 @id @default(cuid())
  contractNumber      String                 @unique @map("contract_number")
  shippingCompanyId   String                 @map("shipping_company_id")
  shippingCompanyName String                 @map("shipping_company_name")
  title               String
  status              CustomerContractStatus @default(Draft)
  markupPercent       Float                  @default(0) @map("markup_percent")
  currency            String                 @default("EUR")
  validFrom           DateTime?              @map("valid_from")
  validTo             DateTime?              @map("valid_to")
  paymentTerms        String?                @map("payment_terms")
  deliveryTerms       String?                @map("delivery_terms")
  notes               String?
  totalBaseValue      Float                  @default(0) @map("total_base_value")
  totalSellValue      Float                  @default(0) @map("total_sell_value")
  itemCount           Int                    @default(0) @map("item_count")
  createdBy           String                 @default("operator") @map("created_by")
  reviewedAt          DateTime?              @map("reviewed_at")
  activatedAt         DateTime?              @map("activated_at")
  archivedAt          DateTime?              @map("archived_at")

  shippingCompany  ShippingCompany                   @relation(fields: [shippingCompanyId], references: [id])
  sourceAgreements CustomerContractSourceAgreement[]
  items            CustomerContractItem[]
  auditEvents      CustomerContractAuditEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shippingCompanyId])
  @@index([status])
  @@index([validTo])
  @@map("customer_contracts")
}

enum CustomerContractStatus {
  Draft
  UnderReview
  Active
  Expired
  Archived
}

model CustomerContractSourceAgreement {
  id                 String @id @default(cuid())
  contractId         String @map("contract_id")
  agreementVersionId String @map("agreement_version_id")
  supplierId         String @map("supplier_id")
  supplierName       String @map("supplier_name")
  includedItemCount  Int    @default(0) @map("included_item_count")

  contract         CustomerContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  agreementVersion AgreementVersion       @relation(fields: [agreementVersionId], references: [id])
  items            CustomerContractItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contractId, agreementVersionId])
  @@index([agreementVersionId])
  @@index([supplierId])
  @@map("customer_contract_source_agreements")
}

model CustomerContractItem {
  id                    String                     @id @default(cuid())
  contractId            String                     @map("contract_id")
  sourceAgreementId     String?                    @map("source_agreement_id")
  agreementItemId       String?                    @map("agreement_item_id")
  supplierId            String                     @map("supplier_id")
  supplierName          String                     @map("supplier_name")
  lineNumber            Int                        @map("line_number")
  itemCode              String?                    @map("item_code")
  vendorPartNumber      String?                    @map("vendor_part_number")
  description           String
  basePrice             Float                      @map("base_price")
  contractMarkupPercent Float                      @map("contract_markup_percent")
  sellPrice             Float                      @map("sell_price")
  currency              String                     @default("EUR")
  unit                  String?
  moq                   Int?
  leadTimeDays          Int?                       @map("lead_time_days")
  hsCode                String?                    @map("hs_code")
  countryOfOrigin       String?                    @map("country_of_origin")
  manufacturer          String?
  status                CustomerContractItemStatus @default(Active)
  reviewNote            String?                    @map("review_note")

  contract        CustomerContract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sourceAgreement CustomerContractSourceAgreement? @relation(fields: [sourceAgreementId], references: [id], onDelete: SetNull)
  agreementItem   AgreementItem?                   @relation(fields: [agreementItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([sourceAgreementId])
  @@index([agreementItemId])
  @@index([supplierId])
  @@map("customer_contract_items")
}

enum CustomerContractItemStatus {
  Active
  Excluded
  NeedsReview
}

model CustomerContractAuditEvent {
  id         String @id @default(cuid())
  contractId String @map("contract_id")
  action     String
  summary    String
  actor      String @default("operator")
  metadata   Json   @default("{}")

  contract CustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contractId, createdAt])
  @@map("customer_contract_audit_events")
}

// ── Agreement Comparisons ──────────────────────────────────────
// Comparison job: uploaded file diffed against baseline agreement items.

model AgreementComparison {
  id        String           @id @default(cuid())
  versionId String           @map("version_id")
  status    ComparisonStatus @default(Queued)

  // Source file
  sourceFileName String @map("source_file_name")
  sourceFileType String @map("source_file_type") // csv | xlsx
  sourceRowCount Int?   @map("source_row_count")

  // Summary
  totalChanges     Int    @default(0) @map("total_changes")
  newItems         Int    @default(0) @map("new_items")
  removedItems     Int    @default(0) @map("removed_items")
  changedItems     Int    @default(0) @map("changed_items")
  priceChanges     Int    @default(0) @map("price_changes")
  totalPriceImpact Float? @map("total_price_impact")

  // Timing
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationMs      Int?      @map("duration_ms")
  progressPct     Int       @default(0) @map("progress_pct")
  progressMessage String?   @map("progress_message")
  error           String?

  // Relations
  version AgreementVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  changes AgreementChange[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([versionId])
  @@index([status])
  @@map("agreement_comparisons")
}

enum ComparisonStatus {
  Queued
  Processing
  ComparisonCompleted @map("Completed")
  ComparisonFailed    @map("Failed")
}

// ── Agreement Changes ──────────────────────────────────────────
// Individual change detected by a comparison job.

model AgreementChange {
  id           String @id @default(cuid())
  comparisonId String @map("comparison_id")

  // Change classification
  changeType ChangeType @map("change_type")
  matchKey   String     @map("match_key") // OFFI/CSI/vendor part that links old→new

  // Item identification
  offiNumber       String? @map("offi_number")
  systemId         String? @map("system_id")
  vendorPartNumber String? @map("vendor_part_number")
  description      String?

  // Diff values (JSON: { field: value })
  oldValues     Json     @default("{}") @map("old_values")
  newValues     Json     @default("{}") @map("new_values")
  changedFields String[] @default([]) @map("changed_fields")

  // Price specifics (denormalized for fast display)
  priceOld     Float? @map("price_old")
  priceNew     Float? @map("price_new")
  priceDiffPct Float? @map("price_diff_pct")

  // Review
  reviewStatus    ReviewStatus @default(Pending) @map("review_status")
  reviewedAt      DateTime?    @map("reviewed_at")
  reviewedBy      String?      @map("reviewed_by")
  appliedToItemId String?      @map("applied_to_item_id") // AgreementItem.id after apply

  // Link to baseline item if matched
  baselineItemId String? @map("baseline_item_id")

  comparison AgreementComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([comparisonId])
  @@index([reviewStatus])
  @@map("agreement_changes")
}

enum ChangeType {
  New
  Removed
  PriceChange @map("Price Change")
  FieldChange @map("Field Change")
}

enum ReviewStatus {
  Pending
  Accepted
  RejectedReview @map("Rejected")
  AutoApplied    @map("Auto Applied")
}

// ── Agreement Insights ─────────────────────────────────────────
// Agent-generated insights for the agreements module.

model AgreementInsight {
  organizationId String? @map("organization_id")
  id         String  @id @default(cuid())
  type       String // comparison_result, agreement_created, agreement_status_changed, contract_expiring, contract_expired, stale_drafts, agreement_updated
  severity   String  @default("info") // info, warning, critical
  title      String
  message    String
  suggestion String?

  // Context
  supplierId   String? @map("supplier_id")
  supplierName String? @map("supplier_name")
  versionId    String? @map("version_id")
  comparisonId String? @map("comparison_id")

  // Payload (structured data for frontend rendering)
  payload Json @default("{}")

  // State
  dismissed   Boolean   @default(false)
  dismissedAt DateTime? @map("dismissed_at")
  dedupeKey   String?   @unique @map("dedupe_key")
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dismissed, type])
  @@index([supplierId])
  @@map("agreement_insights")
}

// ── Purchase Orders ─────────────────────────────────────────────

model PurchaseOrder {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")
  poNumber       String  @unique @map("po_number")

  // Order classification (supply chain tier)
  orderType OrderType @default(DirectPO) @map("order_type")

  // Vessel context
  vessel      String
  vesselImo   String? @map("vessel_imo")
  vesselOwner String? @map("vessel_owner")

  // Supplier context
  supplier    String // display name (backward-compat)
  supplierRef String? @map("supplier_ref")
  supplierId  String? @map("supplier_id") // FK to Supplier table

  // Buyer context (for BuyerPO type — the shipping company that sent the order)
  buyerName String? @map("buyer_name")
  buyerRef  String? @map("buyer_ref")

  // Parent-child lineage (one buyer PO → many sub-supplier POs)
  parentOrderId String? @map("parent_order_id")

  // External platform identifiers (ShipServ-ready)
  shipservRfqId     String?            @map("shipserv_rfq_id")
  shipservPoId      String?            @map("shipserv_po_id")
  shipservQuoteId   String?            @map("shipserv_quote_id")
  shipservLifecycle ShipServLifecycle? @map("shipserv_lifecycle")

  // Link to internal RFQ
  rfqId String? @map("rfq_id")

  // Logistics
  port          String?
  eta           DateTime
  requestedDate DateTime? @map("requested_date")
  confirmedDate DateTime? @map("confirmed_date")

  // Financials
  total     Float
  currency  String @default("EUR")
  marginPct Float  @map("margin_pct")
  markupPct Float? @map("markup_pct") // markup applied on sub-POs relative to buyer price

  // Status
  status        OrderStatus   @default(Pending_Approval)
  confirmStatus ConfirmStatus @default(Unconfirmed)
  priority      Priority      @default(Normal)

  // Financials — margin
  costTotal      Float?  @map("cost_total")
  marginOverride Boolean @default(false) @map("margin_override")

  // Content
  legacyNotes String? @map("notes")
  assignedToId String? @map("assigned_to_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  supplierRel  Supplier?       @relation(fields: [supplierId], references: [id])
  parentOrder  PurchaseOrder?  @relation("OrderLineage", fields: [parentOrderId], references: [id])
  childOrders  PurchaseOrder[] @relation("OrderLineage")
  rfq          Rfq?            @relation(fields: [rfqId], references: [id])
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo   User?           @relation("PurchaseOrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  lines               PurchaseOrderLine[]
  events              PurchaseOrderEvent[]
  orderNotes          PurchaseOrderNote[]
  documents           PurchaseOrderDocument[]
  primarySlaEvidence  SlaEvidence[]              @relation("PrimarySlaEvidence")
  slaEvidenceLinks    SlaEvidencePurchaseOrder[]
  pricingIssues       PricingIssue[]
  financeRecords      FinanceRecord[]
  customerInvoices    CustomerInvoice[]
  supplierInvoices    SupplierInvoice[]
  marginSnapshots     OrderMarginSnapshot[]
  financeExceptions   FinanceException[]
  backorder           Backorder?
  goodsReceipts       GoodsReceipt[]
  deliveries          Delivery[]
  canonicalSalesOrder SalesOrder?

  @@index([orderType])
  @@index([parentOrderId])
  @@index([shipservPoId])
  @@index([supplierId])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId, status])
  @@map("purchase_orders")
}

model PurchaseOrderNote {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  text      String
  author    String   @default("operator") // operator | system | agent
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("purchase_order_notes")
}

model PurchaseOrderEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  type      String // created, status_changed, eta_updated, note_added, exception_flagged, confirmation_requested, line_updated, approval, document_attached
  summary   String // Human-readable description
  detail    String? // Optional structured detail (JSON or freetext)
  actor     String   @default("operator") // operator, system, agent
  createdAt DateTime @default(now()) @map("created_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("purchase_order_events")
}

model PurchaseOrderDocument {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  fileName        String   @map("file_name")
  originalName    String?  @map("original_name")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  storageProvider String   @default("local") @map("storage_provider")
  storageKey      String   @map("storage_key")
  category        String   @default("other")
  description     String?
  uploadedBy      String   @default("operator") @map("uploaded_by")
  createdAt       DateTime @default(now()) @map("created_at")

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slaEvidence SlaEvidence?

  @@index([orderId, createdAt])
  @@map("purchase_order_documents")
}

model SlaEvidence {
  id             String            @id @default(cuid())
  documentId     String?           @unique @map("document_id")
  primaryOrderId String?           @map("primary_order_id")
  vendorName     String            @map("vendor_name")
  fileName       String            @map("file_name")
  originalName   String?           @map("original_name")
  fileType       String            @map("file_type")
  sizeBytes      Int?              @map("size_bytes")
  evidenceDate   DateTime?         @map("evidence_date")
  source         String            @default("upload")
  status         SlaEvidenceStatus @default(Completed)
  extractedText  String?           @map("extracted_text")
  extractedPOs   Json              @default("[]") @map("extracted_pos")
  parserWarnings Json              @default("[]") @map("parser_warnings")
  metrics        Json              @default("{}")
  reviewedAt     DateTime?         @map("reviewed_at")
  reviewedBy     String?           @map("reviewed_by")
  archivedAt     DateTime?         @map("archived_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  document     PurchaseOrderDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  primaryOrder PurchaseOrder?             @relation("PrimarySlaEvidence", fields: [primaryOrderId], references: [id], onDelete: SetNull)
  links        SlaEvidencePurchaseOrder[]

  @@index([status, createdAt])
  @@index([primaryOrderId])
  @@map("sla_evidence")
}

model SlaEvidencePurchaseOrder {
  id         String   @id @default(cuid())
  evidenceId String   @map("evidence_id")
  orderId    String   @map("order_id")
  matchedBy  String   @default("operator") @map("matched_by")
  createdAt  DateTime @default(now()) @map("created_at")

  evidence SlaEvidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  order    PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, orderId])
  @@index([orderId])
  @@map("sla_evidence_purchase_orders")
}

model PurchaseOrderLine {
  id         String @id @default(cuid())
  orderId    String @map("order_id")
  lineNumber Int    @map("line_number")

  // Item
  itemCode       String? @map("item_code")
  description    String
  supplierPartNo String? @map("supplier_part_no")

  // Quantities
  qtyOrdered   Float  @map("qty_ordered")
  qtyConfirmed Float? @map("qty_confirmed")
  qtyDelivered Float  @default(0) @map("qty_delivered")
  uom          String @default("EA")

  // Pricing
  unitPrice Float  @map("unit_price")
  lineTotal Float  @map("line_total")
  currency  String @default("EUR")

  // Supply chain line lineage (sub-PO line → parent buyer PO line)
  parentLineId       String? @map("parent_line_id")
  buyerUnitPrice     Float?  @map("buyer_unit_price") // the buyer's price (for margin calc)
  forwardedToOrderId String? @map("forwarded_to_order_id") // set on buyer PO line once forwarded

  // Dates
  requestedDate DateTime? @map("requested_date")
  confirmedDate DateTime? @map("confirmed_date")

  // Status
  status  LineStatus @default(Open)
  remarks String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Self-referential line lineage
  parentLine           PurchaseOrderLine?    @relation("LineLineage", fields: [parentLineId], references: [id])
  childLines           PurchaseOrderLine[]   @relation("LineLineage")
  customerInvoiceLines CustomerInvoiceLine[]
  supplierInvoiceLines SupplierInvoiceLine[]
  backorderLines       BackorderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  deliveryLines        DeliveryLine[]
  salesOrderLine       SalesOrderLine?

  @@unique([orderId, lineNumber])
  @@index([parentLineId])
  @@map("purchase_order_lines")
}

model Backorder {
  mailboxReplies MailboxReply[]
  id              String            @id @default(cuid())
  organizationId  String            @map("organization_id")
  legalEntityId   String?           @map("legal_entity_id")
  purchaseOrderId String            @unique @map("purchase_order_id")
  supplierId      String?           @map("supplier_id")
  backorderNumber String?           @map("backorder_number")
  sourceKey       String            @unique @map("source_key")
  status          BackorderStatus   @default(Open)
  priority        BackorderPriority @default(Normal)
  reason          String?
  notes           String?
  ownerId         String?           @map("owner_id")
  ownerName       String?           @map("owner_name")
  openedAt        DateTime          @default(now()) @map("opened_at")
  escalatedAt     DateTime?         @map("escalated_at")
  resolvedAt      DateTime?         @map("resolved_at")
  dismissedAt     DateTime?         @map("dismissed_at")
  lastReviewedAt  DateTime?         @map("last_reviewed_at")
  source          String            @default("purchase_order_lines")
  version         Int               @default(1)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity   LegalEntity?    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines         BackorderLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, backorderNumber])
  @@index([organizationId, status, priority])
  @@index([supplierId, status])
  @@map("backorders")
}

model BackorderLine {
  id                  String              @id @default(cuid())
  backorderId         String              @map("backorder_id")
  purchaseOrderLineId String              @map("purchase_order_line_id")
  quantity            Float
  requestedDate       DateTime?           @map("requested_date")
  expectedDate        DateTime?           @map("expected_date")
  status              BackorderLineStatus @default(Open)
  notes               String?
  resolvedAt          DateTime?           @map("resolved_at")

  backorder         Backorder         @relation(fields: [backorderId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([backorderId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
  @@index([backorderId, status])
  @@map("backorder_lines")
}

enum BackorderStatus {
  Open
  Escalated
  Resolved
  Dismissed
}

enum BackorderPriority {
  Normal
  High
  Critical
}

enum BackorderLineStatus {
  Open
  Resolved
  Cancelled
}

model GoodsReceipt {
  id                   String             @id @default(cuid())
  organizationId       String             @map("organization_id")
  legalEntityId        String?            @map("legal_entity_id")
  purchaseOrderId      String             @map("purchase_order_id")
  supplierId           String?            @map("supplier_id")
  partyId              String?            @map("party_id")
  receiptNumber        String?            @map("receipt_number")
  sourceKey            String             @unique @map("source_key")
  supplierDeliveryNote String?            @map("supplier_delivery_note")
  status               GoodsReceiptStatus @default(Draft)
  warehouse            String?
  notes                String?
  receivedAt           DateTime           @default(now()) @map("received_at")
  receivedById         String?            @map("received_by_id")
  receivedByName       String?            @map("received_by_name")
  postedAt             DateTime?          @map("posted_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  version              Int                @default(1)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity   LegalEntity?       @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
