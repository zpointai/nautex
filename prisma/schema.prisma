  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  party         Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, status, receivedAt])
  @@index([purchaseOrderId, status])
  @@index([supplierId, receivedAt])
  @@index([partyId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  orderUnit           String? @map("order_unit")
  stockUnit           String? @map("stock_unit")
  stockPerOrderUnit    Decimal @default(1) @map("stock_per_order_unit") @db.Decimal(18, 6)
  conversionId        String? @map("conversion_id")
  id                  String  @id @default(cuid())
  goodsReceiptId      String  @map("goods_receipt_id")
  purchaseOrderLineId String  @map("purchase_order_line_id")
  inventoryItemId     String? @map("inventory_item_id")
  inventoryMovementId String? @unique @map("inventory_movement_id")
  quantity            Float
  notes               String?

