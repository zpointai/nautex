  deliveryLines        DeliveryLine[]
  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([itemCode])
  @@index([warehouse])
  @@index([catalogItemId])
  @@index([organizationId, warehouse])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String   @id @default(cuid())
  inventoryItemId String   @map("inventory_item_id")
  movementType    String   @map("movement_type")
  quantity        Int
  quantityBefore  Int      @map("quantity_before")
  quantityAfter   Int      @map("quantity_after")
  source          String   @default("manual")
  referenceType   String?  @map("reference_type")
  referenceId     String?  @map("reference_id")
  referenceLabel  String?  @map("reference_label")
  idempotencyKey  String?  @unique @map("idempotency_key")
  note            String?
  actor           String   @default("operator")
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine?
  deliveryLine     DeliveryLine?

  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model InventoryReservation {
  id              String    @id @default(cuid())
  inventoryItemId String    @map("inventory_item_id")
  orderId         String    @map("order_id")
  orderLineId     String    @map("order_line_id")
  quantity        Int
  orderUnit       String?   @map("order_unit")
  stockUnit       String?   @map("stock_unit")
  stockPerOrderUnit Decimal  @default(1) @map("stock_per_order_unit") @db.Decimal(18, 6)
  conversionId    String?   @map("conversion_id")
  status          String    @default("Active")
  referenceLabel  String?   @map("reference_label")
  note            String?
  actor           String    @default("operator")
  reservedAt      DateTime  @default(now()) @map("reserved_at")
  releasedAt      DateTime? @map("released_at")
  issuedAt        DateTime? @map("issued_at")

  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  deliveryLines DeliveryLine[]

  @@index([inventoryItemId, status])
  @@index([orderId])
  @@index([orderLineId])
  @@map("inventory_reservations")
}

model InventoryTransfer {
  id                   String   @id @default(cuid())
  sourceItemId         String   @map("source_item_id")
  destinationItemId    String   @map("destination_item_id")
  quantity             Int
  sourceWarehouse      String   @map("source_warehouse")
  sourceBin            String?  @map("source_bin")
  destinationWarehouse String   @map("destination_warehouse")
  destinationBin       String?  @map("destination_bin")
  note                 String?
  actor                String   @default("operator")
  createdAt            DateTime @default(now()) @map("created_at")

  sourceItem      InventoryItem @relation("InventoryTransferSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  destinationItem InventoryItem @relation("InventoryTransferDestination", fields: [destinationItemId], references: [id], onDelete: Cascade)

  @@index([sourceItemId, createdAt])
  @@index([destinationItemId, createdAt])
  @@map("inventory_transfers")
}

model InventoryCycleCount {
  id               String                    @id @default(cuid())
  inventoryItemId  String                    @map("inventory_item_id")
  expectedQuantity Int                       @map("expected_quantity")
  countedQuantity  Int                       @map("counted_quantity")
  variance         Int
  status           InventoryCycleCountStatus @default(PendingReview)
  note             String?
  reviewNote       String?                   @map("review_note")
  countedBy        String                    @default("operator") @map("counted_by")
  reviewedBy       String?                   @map("reviewed_by")
  countedAt        DateTime                  @default(now()) @map("counted_at")
  reviewedAt       DateTime?                 @map("reviewed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, status])
  @@index([status, countedAt])
  @@map("inventory_cycle_counts")
}

enum InventoryCycleCountStatus {
  PendingReview
  Approved
  Rejected
}

